{
    "files.exclude": {
        // hide generate files in explorer view. there was many
        // files which make navigation painfull.
        "**/*.swp": true
    },
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 80,
    "[asciidoc]": {
        "editor.wordWrap": "wordWrapColumn"
    },
    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn"
    },
    "editor.rulers": [80]
}